<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Book Note</title>
    <link rel="stylesheet" href="./css/index.css">
</head>
 
<body>
     
        <section id="main-image" >
           <div class="main_text">
             <h2>Book<br><span class="note">Note</span><br><span class="wel">Welcome Jojo404</span></h2> 
            </div> 
		</section>

    <div class="conteneur">
        <div class="header">
            <div class="boutton">
               <form action="/add" method="post">
                  <button type="submit">Ajouter un Livre</button>
               </form>
               <form action="/get_book" method="post" id="search">
                   <input type="text" placeholder="Rechercher un livre" name="search-book" style="padding: 10px; width: 200px;">
                   <button type="submit">Rechercher</button>
               </form>
               <form action="/acceuil" method="post">
                   <button type="submit">Home</button>
               </form>
               <br><br><br><br>
           </div>
           
        </div>

        <br><br>
        <div  class="card_container">
            <h3 class="Mes_notes">Mes Notes  <span style="font-size: 30px; color: #ffde0a;">( 0<%=book.length%> Resultats)</span></h3>
            <div class="carte" id="carte" > 
                <% for (let i = 0 ; i< book.length ; i++){%>
                 <div class="cart1" style="text-align: center;">
                         <img src="img/IMG_1390.JPG" alt="">
                             <p style="font-weight: bold;"><span style="font-size: 15pt;"><%=book[i].title %></span> <br>
                            <span style="font-size: 10pt; font-weight: 400;">De <%=book[i].author %></span> <br>
                             </p>
                         <p> <span style="font-size: 10pt; font-weight: 400;"><%= book[i].year %></span></p>
                          <div style="display: flex; gap: 5px; justify-content: center;">
                             <form action="/update" method="post">
                                 <button style="background-color:  #000e29; cursor: pointer; color: white; " name="btnValue" value="<%= book[i].id %>" >Acceder</button> 
                             </form>
                             <form action="/delete_book" method="post" >
                                 <button style="background-color: rgb(81, 37, 37); border: none; color: white; cursor: pointer;" value="<%= book[i].id %>"  name="btnDelete">Suprimer</button>
                             </form>
                          </div>
                         </div>
                         <% } %>
            </div> 
        </div>

            </div>
            <br>
   
        </div>
    </div><br><br><br>
    <footer>
        <p style="color: white; text-align: center;">No framwork , 100% HTML Css And JS Responsive Website © 2024 By Awoumou Joseph All Right Reserved</p>
    </footer>
</body>
</html>